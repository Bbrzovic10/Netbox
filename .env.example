# -----------------------------------------------------------------------------
# Datenbank – Postgres (Neon / Supabase), online-tauglich
# -----------------------------------------------------------------------------
# DATABASE_URL: die GEPOOLTE Verbindung (Host enthaelt "-pooler") -> App-Betrieb
DATABASE_URL="postgresql://USER:PASSWORT@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT_URL: die DIREKTE Verbindung (ohne "-pooler") -> Migrationen / prisma db push
DIRECT_URL="postgresql://USER:PASSWORT@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# -----------------------------------------------------------------------------
# Optional: rein lokale Entwicklung mit SQLite
# Dazu in prisma/schema.prisma provider zurueck auf "sqlite" stellen und
# die directUrl-Zeile entfernen. Dann genuegt:
# DATABASE_URL="file:./dev.db"
